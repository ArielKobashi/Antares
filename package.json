{
  "name": "antares-erp",
  "version": "0.1.0",
  "private": true,
  "description": "ANTARES ERP monorepo",
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:generate": "npm run db:generate -w @antares/database",
    "db:seed": "npm run db:seed -w @antares/database"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  }
}
